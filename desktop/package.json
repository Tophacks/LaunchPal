{
  "name": "launchpal-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LaunchPal desktop helper: automatic screen capture, click-through ring overlay, control window.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node scripts/run-electron.js",
    "dev": "npm run build && node scripts/run-electron.js --dev",
    "dev-panel": "npm run build && node scripts/run-electron.js --dev --dev-panel",
    "fixture-demo": "npm run build && node scripts/run-electron.js --dev --fixture ../services/vision/fixtures/start.png,../services/vision/fixtures/blocked.png,../services/vision/fixtures/success.png",
    "test-rings": "npm run build && node scripts/run-electron.js --dev --test-rings"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "typescript": "5.9.3"
  }
}
