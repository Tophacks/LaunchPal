# Required (server-side only; never commit real values)
INSPECT_BEARER_TOKEN=change-me      # shared with the Wasp server proxy
OPENAI_API_KEY=sk-...
# Optional
OPENAI_MODEL=gpt-5.4                # image-capable Responses API model. gpt-5.4/5.5 ground boxes accurately; gpt-4.1 does not
OPENAI_REASONING_EFFORT=low         # default "low" for gpt-5*/o* models; ignored otherwise
OPENAI_TIMEOUT_MS=12000
PORT=8080
GUIDE_PATH=                         # default: guide/acme-sync.md
