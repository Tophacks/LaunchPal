{
  "name": "launchpal-vision",
  "version": "0.1.0",
  "private": true,
  "description": "LaunchPal screenshot inspection service (POST /inspect, GET /health)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "fixtures": "tsx scripts/render-fixtures.ts",
    "fixtures:screen": "tsx scripts/render-screen-fixtures.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify-fixtures.ts"
  },
  "dependencies": {
    "openai": "^7.62.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
