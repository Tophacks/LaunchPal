# Copy to .env.server (never commit it). Server-side only.
# Maritime inspection service (Nate). MARITIME_TOKEN = the service's INSPECT_BEARER_TOKEN.
MARITIME_INSPECT_URL=https://launchpal-vision.onrender.com
# local alternative: http://localhost:8080 (cd services/vision && npm run dev)
MARITIME_TOKEN=change-me
# Voice (Alisa). Replace "placeholder" with your ElevenLabs API key. Voice stays off until both are set.
ELEVENLABS_API_KEY=placeholder
# Printed by `node voice/setup-agent.mjs`, which creates the LaunchPal agent in your ElevenLabs account.
ELEVENLABS_AGENT_ID=
